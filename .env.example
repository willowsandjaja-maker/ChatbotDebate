# Copy this file to .env and paste your keys in.

# Claude (https://platform.claude.com -> API keys)
ANTHROPIC_API_KEY=
# Optional: claude-sonnet-5 (default, smart + fast) or claude-haiku-4-5 (cheaper, fastest)
ANTHROPIC_MODEL=claude-sonnet-5

# ElevenLabs (https://elevenlabs.io -> Developers -> API Keys)
# The key needs Text to Speech + Voices (read) permissions.
ELEVENLABS_API_KEY=
# Optional: eleven_flash_v2_5 (default, lowest delay) or eleven_multilingual_v2 (richer voice)
ELEVENLABS_MODEL=eleven_flash_v2_5

# How many lines the bots say back-to-back before pausing for the audience
MAX_AUTO_TURNS=16
PORT=3000
